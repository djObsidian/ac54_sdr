# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/

# Build / tool output
tools/build/
*.obj
*.o
*.exe
!tool/**/sdrcapture.exe

# Capture output (keep samples small on purpose)
artifacts/samples/*
!artifacts/samples/.gitkeep

# Temp
tmp/
*.tmp

# External reference sources (clone: git clone --depth 1 https://github.com/lwfinger/rtw88 ref/rtw88)
ref/

# Captures / device-specific dumps
tools/cap/
tools/*.bin
tools/ss.log
tools/ss.err
*.cs16
*.cf32
__pycache__/
*.pyc
# Raw RF response captures stay local; tables, logs and plots are versionable.
artifacts/response-*/*.bin

